import Link from 'next/link';

async function getNews() {
  try {
    // Пробуем взять новости РБК через другой, более надежный сервис
    const res = await fetch('https://api.allorigins.win/get?url=' + encodeURIComponent('https://rssexport.rbc.ru/rbcnews/news/30/full.rss'), {
      next: { revalidate: 3600 }
    });
    
    if (!res.ok) return [];
    
    const data = await res.json();
    const xmlText = data.contents;
    
    // Грубый парсинг без библиотек
    const items = [];
    const itemRegex = /<item>([\s\S]*?)<\/item>/g;
    let match;
    let count = 0;
    
    while ((match = itemRegex.exec(xmlText)) !== null && count < 4) {
      const itemStr = match[1];
      const titleMatch = itemStr.match(/<title>([^<]*)<\/title>/);
      const linkMatch = itemStr.match(/<link>([^<]*)<\/link>/);
      
      if (titleMatch && linkMatch) {
        items.push({
          id: count,
          title: titleMatch[1].replace("<![CDATA[", "").replace("]]>", "").trim(),
          link: linkMatch[1],
          pubDate: "Сегодня",
          source: 'РБК'
        });
        count++;
      }
    }
    return items;
  } catch (error) {
    return [];
  }
}

export default async function NewsFeed() {
  const news = await getNews();

  return (
    <section className="py-8 bg-white border-y border-gray-100">
      <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div className="flex items-center justify-between mb-6">
          <h2 className="text-xl font-bold text-gray-900 flex items-center gap-3">
            <span className="w-2.5 h-2.5 rounded-full bg-indigo-600 animate-pulse"></span>
            Финансовая сводка
          </h2>
          <span className="text-xs text-gray-500 font-medium bg-gray-100 px-2 py-1 rounded-md">Свежее</span>
        </div>

        {/* Если новости не пришли — показываем красную ошибку, а не пустоту */}
        {news.length === 0 ? (
          <div className="p-4 bg-red-50 text-red-600 border border-red-200 rounded-lg text-sm font-medium">
            Блок на месте, но данные от РБК не загрузились. Проверяем API.
          </div>
        ) : (
          <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
            {news.map((item) => (
              <Link key={item.id} href={item.link || '#'} target="_blank" rel="nofollow noopener noreferrer" className="group block p-5 bg-white rounded-xl border border-gray-200 transition-all duration-300 hover:border-indigo-600 hover:shadow-md">
                <div className="flex justify-between items-center mb-3">
                  <span className="text-[10px] font-bold uppercase tracking-wider text-gray-400 group-hover:text-indigo-600 transition-colors">{item.source}</span>
                  <span className="text-xs text-gray-400">{item.pubDate}</span>
                </div>
                <h3 className="text-sm font-semibold text-gray-900 leading-snug group-hover:text-indigo-600 transition-colors">{item.title}</h3>
              </Link>
            ))}
          </div>
        )}

      </div>
    </section>
  );
}